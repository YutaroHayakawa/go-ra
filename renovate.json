    {
      "matchPackageNames": ["github.com/creasty/defaults"],
      "allowedVersions": "/^v?1\\.7\\.0$/"
    },
    {
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "non-major dependencies"
    }
  ]
}
