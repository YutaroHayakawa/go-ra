{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "non-major dependency updates"
    },
    {
      "matchPackageNames": ["github.com/creasty/defaults"],
      "versioning": "semver:v1.7.0"
    }
  ]
}
